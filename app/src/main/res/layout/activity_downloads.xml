<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/xa_background"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/download_toolbar"
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:background="@drawable/bg_page_header"
        android:paddingHorizontal="8dp"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationIconTint="@color/xa_text"
        app:subtitle="DOWNLOADS / OFFLINE GALLERY"
        app:subtitleTextColor="@color/xa_muted"
        app:title="下载星港"
        app:titleTextColor="@color/xa_text" />

    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.XA.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/page_side_padding"
        android:layout_marginTop="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_download_overview"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="把喜欢的作品带到本地"
                android:textColor="@color/xa_text"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="保存位置  Pictures/PixivXA"
                android:textColor="@color/xa_muted"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView android:id="@+id/download_running_count"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="0" android:textColor="@color/pink_500" android:textSize="22sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="进行中" android:textColor="@color/xa_muted" android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView android:id="@+id/download_completed_count"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="0" android:textColor="@color/violet_400" android:textSize="22sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="已完成" android:textColor="@color/xa_muted" android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.35"
                    android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="PIXIV XA" android:textColor="@color/cyan_400" android:textSize="15sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="本地收藏舱" android:textColor="@color/xa_muted" android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="17dp">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="任务队列" android:textColor="@color/xa_text" android:textSize="15sp" android:textStyle="bold" />
        <TextView android:id="@+id/download_task_count" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="暂无任务" android:textColor="@color/xa_muted" android:textSize="12sp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/download_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingHorizontal="12dp"
            android:paddingBottom="24dp" />

        <LinearLayout
            android:id="@+id/download_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:layout_marginHorizontal="22dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_empty_download"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="28dp">
            <ImageView android:layout_width="52dp" android:layout_height="52dp"
                android:background="@drawable/bg_soft_pill" android:padding="13dp"
                android:contentDescription="下载" android:src="@drawable/ic_download" app:tint="@color/pink_500" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="10dp" android:text="这里还很安静" android:textColor="@color/xa_text"
                android:textSize="16sp" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:gravity="center"
                android:text="在作品详情点击下载后，预览图和实时进度会出现在这里。"
                android:textColor="@color/xa_muted" android:textSize="12sp" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
