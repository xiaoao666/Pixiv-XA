<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/xa_background"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/tags_toolbar"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:background="@drawable/bg_page_header"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationIconTint="@color/xa_text"
        app:subtitle="每个标签都取 Pixiv 趋势作品作封面"
        app:subtitleTextColor="@color/xa_muted"
        app:title="热门标签图鉴"
        app:titleTextColor="@color/xa_text" />

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/tags_type"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="12dp"
        android:paddingTop="8dp"
        app:singleSelection="true">
        <com.google.android.material.chip.Chip android:id="@+id/tags_illust"
            style="@style/Widget.XA.Chip" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:checked="true" android:text="插画标签" />
        <com.google.android.material.chip.Chip android:id="@+id/tags_novel"
            style="@style/Widget.XA.Chip" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="小说标签" />
    </com.google.android.material.chip.ChipGroup>

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/tags_refresh"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/tags_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:padding="@dimen/grid_side_padding"
            android:paddingBottom="24dp" />
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
</LinearLayout>
