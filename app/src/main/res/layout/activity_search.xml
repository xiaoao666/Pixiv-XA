<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/xa_background" android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar android:id="@+id/search_toolbar"
        android:layout_width="match_parent" android:layout_height="72dp" android:background="@drawable/bg_page_header"
        app:navigationIcon="@drawable/ic_arrow_back" app:title="搜索星域"
        app:subtitle="作品、标签、漫画与小说" app:titleTextColor="@color/xa_text"
        app:subtitleTextColor="@color/xa_muted" app:navigationIconTint="@color/xa_text" />

    <com.google.android.material.textfield.TextInputLayout android:id="@+id/search_page_box"
        style="@style/Widget.Material3.TextInputLayout.FilledBox" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginHorizontal="14dp" android:hint="输入关键词"
        app:boxBackgroundColor="@color/xa_surface" app:boxCornerRadiusTopStart="20dp"
        app:boxCornerRadiusTopEnd="20dp" app:boxCornerRadiusBottomStart="20dp"
        app:boxCornerRadiusBottomEnd="20dp" app:endIconMode="custom" app:endIconDrawable="@drawable/ic_search">
        <com.google.android.material.textfield.TextInputEditText android:id="@+id/search_page_input"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:imeOptions="actionSearch"
            android:inputType="text" android:maxLines="1" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/search_suggestions_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="14dp"
        android:layout_marginTop="4dp"
        android:visibility="gone"
        app:cardBackgroundColor="@color/xa_surface"
        app:cardCornerRadius="20dp"
        app:cardElevation="3dp"
        app:strokeColor="@color/xa_outline"
        app:strokeWidth="1dp">
        <LinearLayout
            android:id="@+id/search_suggestions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingVertical="5dp" />
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/search_mode_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="14dp"
        android:layout_marginTop="8dp"
        app:checkedButton="@id/search_mode_works"
        app:selectionRequired="true"
        app:singleSelection="true">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/search_mode_works"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:text="作品 / 标签"
            android:textAllCaps="false" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/search_mode_users"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:text="画师"
            android:textAllCaps="false" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/search_mode_id"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:text="ID 直达"
            android:textAllCaps="false" />
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <HorizontalScrollView android:id="@+id/search_filters" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="7dp" android:scrollbars="none">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="horizontal" android:paddingHorizontal="12dp">
            <com.google.android.material.button.MaterialButton android:id="@+id/filter_sort" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="wrap_content" android:layout_height="42dp" android:text="最新" android:textAllCaps="false" />
            <com.google.android.material.button.MaterialButton android:id="@+id/filter_target" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="wrap_content" android:layout_height="42dp" android:layout_marginStart="6dp" android:text="标签部分匹配" android:textAllCaps="false" />
            <com.google.android.material.button.MaterialButton android:id="@+id/filter_bookmarks" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="wrap_content" android:layout_height="42dp" android:layout_marginStart="6dp" android:text="收藏数" android:textAllCaps="false" />
            <com.google.android.material.button.MaterialButton android:id="@+id/filter_type" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="wrap_content" android:layout_height="42dp" android:layout_marginStart="6dp" android:text="全部类型" android:textAllCaps="false" />
            <com.google.android.material.button.MaterialButton android:id="@+id/filter_period" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="wrap_content" android:layout_height="42dp" android:layout_marginStart="6dp" android:text="全部时间" android:textAllCaps="false" />
            <com.google.android.material.button.MaterialButton android:id="@+id/filter_ai" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="wrap_content" android:layout_height="42dp" android:layout_marginStart="6dp" android:text="AI 不限" android:textAllCaps="false" />
            <com.google.android.material.button.MaterialButton android:id="@+id/filter_r18" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="wrap_content" android:layout_height="42dp" android:layout_marginStart="6dp" android:text="隐藏 R18" android:textAllCaps="false" />
        </LinearLayout>
    </HorizontalScrollView>

    <TextView android:id="@+id/search_result_meta" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:paddingHorizontal="16dp" android:paddingVertical="7dp"
        android:text="输入关键词开始搜索" android:textColor="@color/xa_muted" android:textSize="12sp" />

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout android:id="@+id/search_page_refresh"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/search_page_list"
            android:layout_width="match_parent" android:layout_height="match_parent" android:clipToPadding="false"
            android:paddingHorizontal="9dp" android:paddingBottom="24dp" />
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/search_user_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingHorizontal="14dp"
        android:paddingBottom="24dp"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/search_user_results"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
